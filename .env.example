# ===========================================
# GHN (Giao Hàng Nhanh) Shipping Configuration
# ===========================================

# GHN API Token - lấy từ trang quản lý GHN
GHN_TOKEN=your_ghn_token_here

# GHN Shop ID - ID cửa hàng trên GHN
GHN_SHOP_ID=your_shop_id_here

# GHN API Base URL
# Test: https://dev-online-gateway.ghn.vn
# Production: https://online-gateway.ghn.vn
GHN_BASE_URL=https://dev-online-gateway.ghn.vn

# Địa chỉ kho hàng (nơi gửi đồ)
SHOP_DISTRICT_ID=1542
SHOP_WARD_CODE=21012
